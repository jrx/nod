{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "promise",
    "node"
  ],
  "categories": {

---
import { apps } from '../data/apps';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="app-catalog">
  {apps.map((app) => (
    <a class="app-entry" href={`${base}/connect/community-apps/${app.slug}/`}>
      {app.icon && <img src={`${base}/connect/community-apps/${app.slug}/icon.png`} alt="" width="44" height="44" loading="lazy" />}
      <div>
        <strong>{app.name}</strong>
        <p>{app.description}</p>
        <span>{app.categories.join(' · ') || 'App'} →</span>
      </div>
    </a>
  ))}
</div>

<style>
  .app-catalog { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin-block: 1.5rem; }
  .app-entry { display: flex; align-items: start; gap: 1rem; padding: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; color: var(--sl-color-text); text-decoration: none; }
  .app-entry:hover { border-color: var(--sl-color-accent); }
  .app-entry img { flex: none; margin: 0; border-radius: .35rem; }
  .app-entry strong { font-size: 1.2rem; color: var(--sl-color-white); }
  .app-entry p { margin: .5rem 0 .9rem; font-size: .95rem; line-height: 1.5; }
  .app-entry span { color: var(--sl-color-gray-2); font-size: .8rem; }
</style>
